# ice-agent-console —— 大模型配置
#
# 用法：cp .env.example .env，填下面三行，重启 `npm run dev`。
#   .env 已经进了 .gitignore，token 不会被误提交。
#
# 不填也能跑 —— 会走内置的确定性剧本（见 README「两种模式」）。
# 启动横幅与 `GET /health` 都会报当前是哪种模式，不用猜。

# ---- 必填（要接真模型的话）----
# 你的 token。**任何 OpenAI 兼容的接口都行**（官方 / DeepSeek / 通义 / 本地 ollama、vLLM、LM Studio…）
ICE_LLM_API_KEY=

# ---- 选填 ----
# 接口地址，不含结尾的斜杠，代码会拼上 /chat/completions
# 官方：https://api.openai.com/v1
# 本地 ollama：http://localhost:11434/v1
# 本地 vLLM / LM Studio：http://localhost:8000/v1
ICE_LLM_BASE_URL=https://api.openai.com/v1

# 模型名。注意：**要选支持 tool calling 的模型**，因为这个工程靠工具调用决定画什么
ICE_LLM_MODEL=gpt-4o-mini

# 采样温度。要它稳定地挑工具就调低；要措辞活泼可以调高
ICE_LLM_TEMPERATURE=0.3

# 单次请求超时（毫秒）。本地小模型首字很慢时可以调大
ICE_LLM_TIMEOUT_MS=60000

# 强制模式：auto（默认，有 key 就走模型）/ scripted（永远走剧本）/ llm（必须走模型，没 key 会在启动时报错）
# 演示和录屏建议用 scripted —— 剧本是确定性的，每次跑出来一模一样
ICE_LLM_MODE=auto

# ---- 与模型无关的 ----
# 播放节奏（毫秒/字）。0 = 不等，e2e 用
ICE_AGENT_PACE=
